{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WKT Web：运行并打开浏览器",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_impl/web/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "FLASK_DEBUG": "1"
      },
      "serverReadyAction": {
        "pattern": "请在浏览器打开: (https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "WKT Web：仅启动服务（配合 Simple Browser）",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/test_impl/web/app.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "justMyCode": true,
      "env": {
        "FLASK_DEBUG": "1"
      }
    }
  ]
}
