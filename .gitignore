# 密钥与本地配置（禁止入库）
config/secrets.local.json
config/deploy.local.json
.env
.env.local

# 发布包（本地打 zip/tar 上传用）
release/

# Python
__pycache__/
*.pyc
*.pyo

# 发布备份
release_backup/

# 上传临时文件
test_impl/web/uploads/

# OCR 归档订单（本地文件，不入库）
orders/*
!orders/.gitkeep

# 临时导入诊断用 Excel（勿提交业务数据）
imports/*
!imports/.gitkeep

# 送货单 Excel 模板（含客户信息，可入库同步；仍排除本地临时 uploads）
# 注：customer_profiles / feishu_config 等主数据已允许提交，便于 GitHub 备份

# 本地订单 SQLite（勿提交业务订单库）
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.db.bak*

# Flask 会话签名密钥（各环境独立）
data/auth_secret.txt

# 出货生成的 Excel 附件（随订单库，各环境独立）
data/delivery_notes/attachments/*
!data/delivery_notes/attachments/.gitkeep
